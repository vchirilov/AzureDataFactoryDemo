{
	"name": "thia-export12",
	"properties": {
		"activities": [
			{
				"name": "Execute Pipeline 001",
				"type": "ExecutePipeline",
				"dependsOn": [],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "PulseContactsToIseries1",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true
				}
			},
			{
				"name": "Call E-Mail Notification Service",
				"description": "Send HTTP POST Request to E-Mail Notification Service",
				"type": "WebActivity",
				"dependsOn": [
					{
						"activity": "Execute Pipeline 001",
						"dependencyConditions": [
							"Failed"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "POST",
					"headers": {
						"Content-Type": "application/json"
					},
					"url": "https://prod-245.westeurope.logic.azure.com:443/workflows/96d58046d00247cda915e528e14ada8b/triggers/When_a_HTTP_request_is_received/paths/invoke?api-version=2016-10-01&sp=%2Ftriggers%2FWhen_a_HTTP_request_is_received%2Frun&sv=1.0&sig=ubwxFZvluein_IcngW1Ctb_PgkCvHdi7dz_aQRBq_jY",
					"body": {
						"value": "{\n\"data-factory-name\":\"@{pipeline().DataFactory}\",\n\"error-message\":\"@{activity('Execute Pipeline1').Error.Message}\",\n\"Pipeline\":\"@{pipeline().Pipeline}\",\n\"RunId\":\"@{pipeline().RunId}\"\n}",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Log Failed Pipeline",
				"description": "Mark the pipeline as failed.",
				"type": "Fail",
				"dependsOn": [
					{
						"activity": "Call E-Mail Notification Service",
						"dependencyConditions": [
							"Completed"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"message": {
						"value": "@{activity('Execute Pipeline1').Error.Message}",
						"type": "Expression"
					},
					"errorCode": "500"
				}
			}
		],
		"folder": {
			"name": "thiassis"
		},
		"annotations": []
	}
}